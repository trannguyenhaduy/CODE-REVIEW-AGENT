# .env.example — Code Review Agent · SE373
# ============================================================
# HƯỚNG DẪN: Copy file này thành .env rồi điền giá trị thực.
# TUYỆT ĐỐI KHÔNG commit file .env vào git!
# Vi phạm → bị trừ 1.0 điểm theo quy định rubric.
# ============================================================

# === LLM API KEY & ENDPOINT ===
# Cách 1: Dùng 9Router (Proxy cục bộ: http://localhost:20128/v1)
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=9router
# Tên model tương ứng trong 9Router (ví dụ: gpt-4o-mini, claude-3-5-sonnet, gemini-2.0-flash)
LLM_MODEL=gpt-4o-mini

# Cách 2: Dùng trực tiếp OpenAI chính thức (nếu không dùng 9Router)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...your-key-here...
# LLM_MODEL=gpt-4o-mini

# === MODEL SETTINGS ===
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# === GITHUB INTEGRATION ===
# Fine-grained PAT với scope: contents:read, pull_requests:write, checks:write
GITHUB_TOKEN=ghp_...your-token-here...
GITHUB_OWNER=your-username-or-org
GITHUB_REPO=your-target-repo

# === TARGET REPO ALLOWLIST ===
# Comma-separated list of "owner/repo" patterns agent được phép đọc
ALLOWED_REPOS=your-username/cafe-song-han

# === LANGSMITH TRACING (optional) ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...your-key-here...
LANGCHAIN_PROJECT=code-review-agent-se373

# === VECTOR STORE ===
VECTOR_STORE_PATH=./chroma_db
EMBEDDING_MODEL=text-embedding-3-small

# === AGENT LIMITS ===
# Giới hạn bảo vệ tránh đốt token
MAX_TOOL_CALLS_PER_PR=30
MAX_FINDINGS_PER_PR=15
MAX_DIFF_LINES=3000
TOKEN_BUDGET_PER_CALL=8000

# === APPROVAL / HUMAN-IN-THE-LOOP ===
APPROVAL_TIMEOUT_SECONDS=3600
HITL_ENABLED=true

# === LINTER PATHS ===
RUFF_BINARY=ruff
MYPY_BINARY=mypy
SEMGREP_BINARY=semgrep
BANDIT_BINARY=bandit
LINTER_TIMEOUT_SECONDS=60
